#!/bin/bash
# ============================================================================
#  config.sh — the ONLY file you should need to edit
# ============================================================================
#  Every script reads its settings from here. Change these values once and
#  the whole system follows. Nothing else in the system hardcodes a path,
#  an address or a place name.
#
#  If you change a path here, change it in the crontab too (see system/README).
# ============================================================================

# --- Where things live ------------------------------------------------------
# JOBS_DIR = this folder: the scripts, the quote pool, the cache files.
# REPO_DIR = the folder GitHub publishes from: editions/ and posts/ live here.
JOBS_DIR="${JOBS_DIR:-/home/YOURNAME/jobs}"
REPO_DIR="${REPO_DIR:-/home/YOURNAME/repo/YOUR-REPO}"

# --- The paper --------------------------------------------------------------
# PAPER_NAME appears in the masthead and in email subject lines.
PAPER_NAME="${PAPER_NAME:-The Fenland Herald}"

# SITE_URL is where the paper is published. NO TRAILING SLASH.
# The publisher writes this address into every page and every email link.
SITE_URL="${SITE_URL:-https://YOURNAME.github.io/YOUR-REPO}"

# --- Who gets the email -----------------------------------------------------
# Leave EMAIL_TO empty ("") to skip email entirely and just publish the paper.
EMAIL_TO="${EMAIL_TO:-you@example.com}"

# --- Where you are ----------------------------------------------------------
# Used by the weather block, the almanac and the satellite pass page.
# PLACE_NAME        = how it appears in the paper ("Cambridgeshire", "Kent")
# PLACE_LAT/PLACE_LON = decimal degrees, used for sun, moon and satellite maths
# BBC_WEATHER_ID    = BBC Weather's own location number. Find yours by visiting
#                     bbc.co.uk/weather, searching your town, and reading the
#                     number at the end of the address (/weather/2655603).
# RADIO_GRID        = your Maidenhead locator (amateur radio). Optional.
PLACE_NAME="${PLACE_NAME:-Cambridgeshire}"
PLACE_TOWN="${PLACE_TOWN:-Cambridge}"
PLACE_LAT="${PLACE_LAT:-52.2053}"
PLACE_LON="${PLACE_LON:-0.1218}"
BBC_WEATHER_ID="${BBC_WEATHER_ID:-2655603}"
RADIO_GRID="${RADIO_GRID:-JO02}"

# --- How the AI is called ---------------------------------------------------
# run_agent.sh handles this. These describe HOW, not WHERE.
# See run_agent.sh for the three supported options.
AGENT_CMD="${AGENT_CMD:-rool-llm say /agents/rool/conversations/<conversation-id>}"

# AGENT_ROTATE=1 gives every edition a brand-new conversation, so a run never
# carries the whole archive of past editions into its context. The old ones are
# kept, and each new one is logged to conversations.log.
# AGENT_SPEAKER is the agent that hosts the conversation (rool = this machine).
AGENT_ROTATE="${AGENT_ROTATE:-1}"
AGENT_SPEAKER="${AGENT_SPEAKER:-rool}"

# --- Timezone ---------------------------------------------------------------
# Dates and times in the paper are UTC, so a run never changes date mid-edition.
# The cron line itself uses the machine's local clock.
# Only change this if you move the cron job and know why.
export TZ="${TZ:-UTC}"

# Everything below is derived — do not edit.
export JOBS_DIR REPO_DIR PAPER_NAME SITE_URL EMAIL_TO
export PLACE_NAME PLACE_TOWN PLACE_LAT PLACE_LON BBC_WEATHER_ID RADIO_GRID
export AGENT_CMD AGENT_ROTATE AGENT_SPEAKER
